-- Tabla de usuarios (pilotos)
CREATE TABLE users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    user TEXT NOT NULL,
    email TEXT NOT NULL,
    password TEXT NOT NULL,
    license TEXT NOT NULL,
    admin INTEGER NOT NULL CHECK (admin IN (0, 1))
);

-- Tabla de aeronaves
CREATE TABLE aircrafts (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    modelo TEXT NOT NULL,
    matricula TEXT NOT NULL,
    velocidad TEXT NOT NULL,
    turbulence TEXT NOT NULL,
    combustible TEXT NOT NULL,
    img TEXT NOT NULL
);

-- Tabla de aeropuertos
CREATE TABLE airports (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    ICAO TEXT NOT NULL UNIQUE,
    name TEXT NOT NULL,
    LAT TEXT NOT NULL,
    LON TEXT NOT NULL
);

-- Tabla de planes de vuelo
CREATE TABLE flightplans (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    fpOrigin TEXT NOT NULL,
    fpDestination TEXT NOT NULL,
    distance TEXT NOT NULL,
    maxAltitude TEXT NOT NULL,
    waypoints INTEGER NOT NULL,
    idAircraft INTEGER NOT NULL,
    date TEXT NOT NULL,
    userID INTEGER NOT NULL,
    license TEXT NOT NULL,

    -- Claves foráneas
    FOREIGN KEY (idAircraft) REFERENCES aircrafts(id) ON UPDATE CASCADE ON DELETE CASCADE,
    FOREIGN KEY (userID) REFERENCES users(id) ON UPDATE CASCADE ON DELETE CASCADE,
    FOREIGN KEY (fpOrigin) REFERENCES airports(ICAO) ON UPDATE CASCADE ON DELETE CASCADE,
    FOREIGN KEY (fpDestination) REFERENCES airports(ICAO) ON UPDATE CASCADE ON DELETE CASCADE
);

</sql><current_tab id="0"/></tab_sql></sqlb_project>
